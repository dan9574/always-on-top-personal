{
  "name": "personal-pinned-notes",
  "version": "0.1.0",
  "description": "Native editable pinned notes with a global Ctrl+D toggle.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint src tests",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  }
}
